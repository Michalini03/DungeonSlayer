--- !u!114 &2073210914
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2073210912}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5090430b0ff9e2749b6344f0583faf26, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Intro
  storyCanvasGroup: {fileID: 1363996570}
  storyText: {fileID: 561131798}
  continueText: {fileID: 932877441}
  rootPanel: {fileID: 1363996565}
  pages:
  - 'Four hundred years ago, Darkness engulfed the world. In its shadow came monsters
    and nightmare-beasts that slaughtered without end, reducing hundreds of towns
    and villages to ruin within days. The people prayed to the Old Gods for salvation
    and for the light to return, but their prayers were met only with fear and despair.
    On the seventh day, however, a golden light crossed the starless sky, awakening
    ancient power within the old Oaks, which briefly healed and sheltered those beneath
    their branches.


    That light did not fade. It fell amid blood and ruin where
    a band of outlaws made their last stand, and beside their dying warlord it came
    to rest in the form of a small golden acorn of the Great Oak. As he grasped it
    with his final strength, his wounds closed, the beasts recoiled, and his mind
    was filled with a vision of peace. With that vision came a sacred charge: he
    was to carry the seed and plant it deep within the caverns beneath Mount Blanik.
    Reborn by the light that spared him, he rose and began his final journey.

'
  characterDelay: 0.03
  delayBeforeTyping: 0.2
  delayAfterTyping: 0.4
  nextSceneName: MainMenu
  fadeOverlayCanvasGroup: {fileID: 0}
  sceneFadeDuration: 0.75
